# Copia este archivo a .env.local y rellena con tus credenciales

# ─── SQL Server ────────────────────────────────────────────────────────────
DB_SERVER=localhost
DB_DATABASE=DetectIT
DB_USER=sa
DB_PASSWORD=tu_contraseña_aqui
DB_PORT=1433
DB_ENCRYPT=false

# ─── Groq AI (chatbot gratuito) ────────────────────────────────────────────
# Obtén tu clave gratuita en: https://console.groq.com/keys
GROQ_API_KEY=tu_clave_groq_aqui

# ─── Servidor CNN Python (opcional) ───────────────────────────────────────
# Si tienes el servidor FastAPI corriendo, pon su URL aquí
# Ejecutar con: cd proyecto_xray && uvicorn server:app --port 8000
CNN_SERVER_URL=http://localhost:8000
